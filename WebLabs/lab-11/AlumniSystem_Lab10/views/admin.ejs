<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Admin Dashboard | AlumniConnect</title><link rel="stylesheet" href="/style.css"></head>
<body><header><h1>Alumni Management System</h1></header><nav class="navbar"><div class="logo"><h3>AlumniConnect</h3></div><ul class="nav-links"><li><a href="/admin">Dashboard</a></li><li><a href="/admin/users/new">Create Alumni</a></li><li><a href="/admin/pdf">Export PDF</a></li><li><form method="POST" action="/logout"><button type="submit" class="nav-button">Log out</button></form></li></ul></nav>
<main><div class="container"><div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h2>Alumni Accounts</h2><p>Welcome, <strong><%= currentUser.name %></strong>. Create accounts and monitor profile completion.</p></div><a class="btn" href="/admin/users/new">+ Create Alumni Account</a></div>
<% if (notice) { %><p class="notice"><%= notice %></p><% } %><section class="stats"><div class="stat-card"><span>Total alumni accounts</span><strong><%= stats.total || 0 %></strong></div><div class="stat-card"><span>Profiles completed</span><strong><%= stats.completed || 0 %></strong></div><div class="stat-card"><span>Profiles pending</span><strong><%= (stats.total || 0) - (stats.completed || 0) %></strong></div></section>
<form class="search-box" method="GET" action="/admin"><label for="q">Quick guide</label><p>Use the directory below to view profiles. Account deletion also removes its linked profile.</p></form>
<div class="table-container"><table><thead><tr><th>ID</th><th>Alumni</th><th>Email</th><th>Department</th><th>Graduation</th><th>Profile</th><th>Actions</th></tr></thead><tbody>
<% if (!alumni.length) { %><tr><td colspan="7">No alumni accounts yet. Create the first account to get started.</td></tr><% } %>
<% alumni.forEach(function(a) { %><tr><td><%= a.id %></td><td><div class="table-person"><% if (a.profile_image) { %><img src="/uploads/<%= a.profile_image %>" alt="Profile image"><% } else { %><span class="avatar-placeholder"><%= a.full_name.charAt(0).toUpperCase() %></span><% } %><strong><%= a.full_name %></strong></div></td><td><%= a.email %></td><td><%= a.department || '—' %></td><td><%= a.graduation_year || '—' %></td><td><span class="status <%= a.department ? 'status-complete' : 'status-pending' %>"><%= a.department ? 'Started' : 'Pending' %></span></td><td class="actions"><a class="btn" href="/directory/<%= a.id %>">View</a><form method="POST" action="/admin/users/<%= a.id %>/delete" onsubmit="return confirm('Delete this alumni account and its profile?')"><button class="danger-button" type="submit">Delete</button></form></td></tr><% }) %>
</tbody></table></div><p class="muted">Alumni cannot create accounts themselves. They log in and complete their own profile.</p></div></main><footer><p>Alumni Management System &copy; 2026</p></footer></body></html>
