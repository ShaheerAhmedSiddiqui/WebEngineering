<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Messages | AlumniConnect</title><link rel="stylesheet" href="/style.css"></head>
<body><header><h1>Alumni Management System</h1></header>
<nav class="navbar"><div class="logo"><h3>AlumniConnect</h3></div><ul class="nav-links"><li><a href="/directory">Directory</a></li><li><a href="/my-profile">My Profile</a></li><li><a href="/messages">Messages</a></li><li><form method="POST" action="/logout"><button type="submit" class="nav-button">Log out</button></form></li></ul></nav>
<main><section class="messages-page"><div class="messages-heading"><div><p class="eyebrow">YOUR PRIVATE SPACE</p><h2>Messages</h2><p class="muted">Continue a conversation or find an alumnus in the directory.</p></div><a class="btn" href="/directory">Find Alumni</a></div>
<% if (!conversations.length) { %><div class="messages-empty"><div class="empty-chat-icon">✉</div><h3>No conversations yet</h3><p>Visit the alumni directory and select Message on an alumni profile to start a private conversation.</p><a class="btn" href="/directory">Explore Alumni</a></div><% } else { %>
<div class="conversation-list"><% conversations.forEach(function(person) { %><a class="conversation-item" href="/messages/<%= person.id %>"><% if (person.profile_image) { %><img class="conversation-avatar" src="/uploads/<%= person.profile_image %>" alt=""><% } else { %><span class="conversation-avatar avatar-placeholder"><%= person.full_name.charAt(0).toUpperCase() %></span><% } %><span class="conversation-copy"><strong><%= person.full_name %></strong><span><%= person.last_message %></span></span><time><%= new Date(person.last_message_at).toLocaleDateString() %></time></a><% }) %></div><% } %></section></main>
<footer><p>Alumni Management System &copy; 2026</p></footer></body></html>