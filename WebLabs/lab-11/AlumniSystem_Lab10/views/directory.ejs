<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Alumni Directory | AlumniConnect</title><link rel="stylesheet" href="/style.css"></head>
<body><header><h1>Alumni Management System</h1></header><nav class="navbar"><div class="logo"><h3>AlumniConnect</h3></div><ul class="nav-links"><li><a href="/directory">Directory</a></li><li><a href="/my-profile">My Profile</a></li><% if (currentUser.role === "alumni") { %><li><a href="/messages">Messages</a></li><% } %><li><a href="/profile/edit">Complete Profile</a></li><li><form method="POST" action="/logout"><button type="submit" class="nav-button">Log out</button></form></li></ul></nav>
<main><div class="container"><div class="page-heading"><div><p class="eyebrow">YOUR COMMUNITY</p><h2>Alumni Directory</h2><p>Discover fellow alumni and their professional journeys.</p></div><a class="btn" href="/profile/edit">Update My Profile</a></div><% if (notice) { %><p class="notice"><%= notice %></p><% } %>
<form class="search-box search-inline" method="GET" action="/directory"><label for="q">Search by name, department, company, or skill</label><div class="search-row"><input id="q" name="q" type="text" value="<%= q %>" placeholder="e.g. Software Engineering"><button type="submit">Search</button><a class="btn secondary-btn" href="/directory">Clear</a></div></form>
<div class="directory-grid"><% if (!alumni.length) { %><p>No alumni found. Try another search.</p><% } %><% alumni.forEach(function(a) { %><article class="directory-card"><div class="directory-card-top"><% if (a.profile_image) { %><img class="directory-avatar" src="/uploads/<%= a.profile_image %>" alt="<%= a.full_name %>"><% } else { %><span class="directory-avatar avatar-placeholder"><%= a.full_name.charAt(0).toUpperCase() %></span><% } %><div><h3><%= a.full_name %></h3><p class="muted"><%= a.job_title || 'Alumni member' %></p></div></div><p class="card-meta"><%= a.department || 'Department not added' %><% if (a.graduation_year) { %> · Class of <%= a.graduation_year %><% } %></p><% if (a.company) { %><p><strong>Company:</strong> <%= a.company %></p><% } %><% if (a.skills) { %><p><strong>Skills:</strong> <%= a.skills %></p><% } %><% if (a.bio) { %><p class="bio-preview"><%= a.bio %></p><% } %><a class="btn" href="/directory/<%= a.id %>">View Profile</a><% if (currentUser.role === "alumni" && currentUser.id !== a.id) { %><a class="btn message-link" href="/messages/<%= a.id %>">Message</a><% } %></article><% }) %></div><p class="muted privacy-note">Email addresses, resumes, and private contact information are not shown in the public directory.</p></div></main><footer><p>Alumni Management System &copy; 2026</p></footer></body></html>
