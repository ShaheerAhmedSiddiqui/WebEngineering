PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=alumniconnect_db
SESSION_SECRET=replace-with-a-long-random-secret

# Used once to create the first admin account when this email does not exist.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
NODE_ENV=development

# SMTP email delivery (Gmail example: use a Google App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=your-email@gmail.com
APP_URL=http://localhost:3000

