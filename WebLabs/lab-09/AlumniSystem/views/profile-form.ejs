<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Complete My Profile | AlumniConnect</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <header>
        <h1>Alumni Management System</h1>
    </header>
    <nav class="navbar">
        <div class="logo">
            <h3>AlumniConnect</h3>
        </div>
        <ul class="nav-links">
            <li><a href="/directory">Directory</a></li>
            <li><a href="/my-profile">My Profile</a></li>
            <li>
                <form method="POST" action="/logout"><button type="submit" class="nav-button">Log out</button></form>
            </li>
        </ul>
    </nav>
    <main>
        <div class="container form-container">
            <p class="eyebrow">YOUR INFORMATION</p>
            <h2>Complete Your Alumni Profile</h2>
            <p>Only fill in information you are comfortable sharing. Your contact details remain private unless you
                choose to share them.</p>
            <% if (error) { %>
                <p class="error-message">
                    <%= error %>
                </p>
                <% } %>
                    <form action="/profile/edit" method="POST" enctype="multipart/form-data">
                        <h3>Academic Information</h3><label for="department">Department</label><select id="department"
                            name="department">
                            <option value="">Select department</option>
                            <% ['Computer Science','Information Technology','Software Engineering','Electrical
                                Engineering','Business Administration','Other'].forEach(function(v) { %>
                                <option value="<%= v %>" <%=profile.department===v ? 'selected' : '' %>><%= v %>
                                </option>
                                <% }) %>
                        </select>
                        <label for="degree_program">Degree Program</label><select id="degree_program"
                            name="degree_program">
                            <option value="">Select degree</option>
                            <% ['Associate Degree','BS','BE','BBA','MS','MBA','PhD','Other'].forEach(function(v) { %>
                                <option value="<%= v %>" <%=profile.degree_program===v ? 'selected' : '' %>><%= v %>
                                </option>
                                <% }) %>
                        </select><label for="graduation_year">Graduation Year</label><input id="graduation_year"
                            name="graduation_year" type="number" min="1950" max="2100"
                            value="<%= profile.graduation_year || '' %>"><label for="cgpa">CGPA (out of
                            4.00)</label><input id="cgpa" name="cgpa" type="number" min="0" max="4" step="0.01"
                            value="<%= profile.cgpa || '' %>">
                        <h3>Professional Information</h3><label for="employment_status">Employment Status</label><select
                            id="employment_status" name="employment_status">
                            <option value="">Select status</option>
                            <% ['Student','Employed','Self-employed','Unemployed','Entrepreneur','Further
                                Studies'].forEach(function(v) { %>
                                <option value="<%= v %>" <%=profile.employment_status===v ? 'selected' : '' %>><%= v %>
                                </option>
                                <% }) %>
                        </select><label for="company">Company / Organization</label><input id="company" name="company"
                            value="<%= profile.company || '' %>"><label for="job_title">Job Title</label><input
                            id="job_title" name="job_title" value="<%= profile.job_title || '' %>"><label
                            for="skills">Skills (comma separated)</label><input id="skills" name="skills"
                            value="<%= profile.skills || '' %>" placeholder="Node.js, MySQL, React">
                        <h3>About You</h3><label for="bio">Short Bio</label><textarea id="bio" name="bio" rows="5"
                            maxlength="1500"
                            placeholder="Tell other alumni a little about yourself"><%= profile.bio || '' %></textarea><label
                            for="linkedin">LinkedIn Profile URL</label><input id="linkedin" name="linkedin" type="url"
                            value="<%= profile.linkedin || '' %>" placeholder="https://www.linkedin.com/in/..."><label
                            for="phone">Phone number (private by default)</label><input id="phone" name="phone"
                            type="tel" value="<%= profile.phone || '' %>"><label for="gender">Gender
                            (optional)</label><select id="gender" name="gender">
                            <option value="">Prefer not to say</option>
                            <% ['Male','Female','Other'].forEach(function(v) { %>
                                <option value="<%= v %>" <%=profile.gender===v ? 'selected' : '' %>><%= v %>
                                </option>
                                <% }) %>
                        </select>
                        <h3>Profile Documents</h3>
                        <% if (profile.profile_image) { %>
                            <div class="current-image">
                                <p>Current profile image</p><img src="/uploads/<%= profile.profile_image %>"
                                    alt="Current profile">
                            </div>
                            <% } %><label for="profile_image">Profile Image (JPG, PNG, GIF, WEBP; max 2
                                    MB)</label><input id="profile_image" type="file" name="profile_image"
                                    accept="image/png,image/jpeg,image/gif,image/webp">
                                <% if (profile.resume) { %>
                                    <p class="file-info">Resume already uploaded: <%= profile.resume %>
                                    </p>
                                    <% } %><label for="resume">Resume / CV (PDF, DOC, DOCX; max 2 MB)</label><input
                                            id="resume" type="file" name="resume" accept=".pdf,.doc,.docx"><label
                                            class="checkbox-label"><input type="checkbox" name="contact_visible"
                                                value="1" <%=profile.contact_visible ? 'checked' : '' %>> Allow
                                            signed-in alumni to see my phone number</label><button type="submit">Save
                                            Profile</button><a class="btn secondary-btn" href="/my-profile">Cancel</a>
                    </form>
        </div>
    </main>
    <footer>
        <p>Alumni Management System &copy; 2026</p>
    </footer>
</body>

</html>