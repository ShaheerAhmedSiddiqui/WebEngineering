<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= alumni.full_name %> | AlumniConnect
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <header>
        <h1>Alumni Management System</h1>
    </header>
    <nav class="navbar">
        <div class="logo">
            <h3>AlumniConnect</h3>
        </div>
        <ul class="nav-links">
            <li><a href="<%= currentUser.role === 'admin' ? '/admin' : '/directory' %>">Back</a></li>
            <% if (currentUser.role==='alumni' && currentUser.id===alumni.id) { %>
                <li><a href="/profile/edit">Edit My Profile</a></li>
                <% } %>
                    <li>
                        <form method="POST" action="/logout"><button type="submit" class="nav-button">Log out</button>
                        </form>
                    </li>
        </ul>
    </nav>
    <main>
        <div class="alumni-details">
            <div class="profile-hero">
                <% if (alumni.profile_image) { %><img src="/uploads/<%= alumni.profile_image %>" alt="Profile image">
                    <% } else { %><span class="avatar-placeholder large-avatar">
                            <%= alumni.full_name.charAt(0).toUpperCase() %>
                        </span>
                        <% } %>
                            <div>
                                <p class="eyebrow">ALUMNI PROFILE</p>
                                <h2>
                                    <%= alumni.full_name %>
                                </h2>
                                <p>
                                    <%= alumni.job_title || 'Alumni member' %>
                                        <%= alumni.company ? ' at ' + alumni.company : '' %>
                                </p>
                                <p class="muted">
                                    <%= alumni.department || 'Department not added' %>
                                        <%= alumni.graduation_year ? ' · Class of ' + alumni.graduation_year : '' %>
                                </p>
                            </div>
            </div>
            <h3>Academic Information</h3>
            <p><strong>Department:</strong>
                <%= alumni.department || 'Not provided' %>
            </p>
            <p><strong>Degree program:</strong>
                <%= alumni.degree_program || 'Not provided' %>
            </p>
            <p><strong>Graduation year:</strong>
                <%= alumni.graduation_year || 'Not provided' %>
            </p>
            <h3>Professional Information</h3>
            <p><strong>Employment status:</strong>
                <%= alumni.employment_status || 'Not provided' %>
            </p>
            <p><strong>Company:</strong>
                <%= alumni.company || 'Not provided' %>
            </p>
            <p><strong>Job title:</strong>
                <%= alumni.job_title || 'Not provided' %>
            </p>
            <p><strong>Skills:</strong>
                <%= alumni.skills || 'Not provided' %>
            </p>
            <h3>About</h3>
            <p>
                <%= alumni.bio || 'This alumnus has not added a bio yet.' %>
            </p>
            <% if (alumni.linkedin) { %>
                <p><strong>LinkedIn:</strong> <a href="<%= alumni.linkedin %>" target="_blank"
                        rel="noopener noreferrer">Open LinkedIn profile</a></p>
                <% } %>
                    <% if (canSeeContact && alumni.phone) { %>
                        <p><strong>Phone:</strong>
                            <%= alumni.phone %>
                        </p>
                        <% } else { %>
                            <p class="muted">Contact information is private.</p>
                            <% } %>
                                <% if (currentUser.role==='admin' ) { %>
                                    <hr>
                                    <form method="POST" action="/admin/users/<%= alumni.id %>/delete"
                                        onsubmit="return confirm('Delete this alumni account and profile?')"><button
                                            class="danger-button" type="submit">Delete Alumni Account</button></form>
                                    <% } %>
        </div>
    </main>
    <footer>
        <p>Alumni Management System &copy; 2026</p>
    </footer>
</body>

</html>